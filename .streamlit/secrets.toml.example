# Copiá este archivo como .streamlit/secrets.toml (NO se sube a git)
# En Streamlit Cloud: App settings > Secrets, pegá este mismo contenido.

# Contraseña de acceso a la app (opcional pero recomendada si la URL es pública)
app_password = "cambiame"

[connections.postgresql]
# Supabase > Project Settings > Database > Connection string (pooler, modo Transaction/Session)
url = "postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
